OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TEMPORAL_DB_PATH=./data/temporal.db
TEMPORAL_SEED_DEMO=true
TEMPORAL_APP_URL=http://localhost:3000
# Optional demo-only host for self-contained `pr-1.html` style snapshots.
TEMPORAL_STATIC_ARTIFACT_BASE_URL=
TEMPORAL_COLLECTOR_TOKEN=
# Encrypts OAuth access/refresh tokens stored with MCP connections. Use a
# dedicated high-entropy value in production; local development falls back to
# TEMPORAL_COLLECTOR_TOKEN when this is empty.
TEMPORAL_CREDENTIAL_KEY=
TEMPORAL_VIEWER_SUBJECTS=
# Development/E2E only. Production remote MCP servers must use public HTTPS endpoints.
TEMPORAL_ALLOW_PRIVATE_MCP=false
# The Connections page creates these four values automatically in local development.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_API_VERSION=2026-03-10
# Legacy local fallback only:
GITHUB_TOKEN=
GITHUB_ORG=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=
NOTION_TOKEN=
# claude-mem (local install; auto-detected, all optional)
CLAUDE_MEM_HOME=
CLAUDE_MEM_DB_PATH=
CLAUDE_MEM_WORKER_URL=
CLAUDE_MEM_TRANSPORT=
# Maps claude-mem project names to repositories when the git-context ledger is unavailable:
TEMPORAL_CLAUDE_MEM_PROJECTS=
TEMPORAL_GIT_CONTEXT_PATH=
# Optional bearer token for a saved MCP connection. Reference this variable by
# name in the connection configuration; Temporal never persists the token value.
TEMPORAL_MCP_BEARER_TOKEN=
