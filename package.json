{
  "name": "temporal",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:mcp": "node scripts/e2e-mcp.mjs",
    "temporal:export": "node --env-file-if-exists=.env.local --import tsx scripts/export-evidence.mts",
    "temporal:ci": "node --import tsx scripts/temporal-ci.mts",
    "temporal:comment": "node --import tsx scripts/temporal-comment.mts",
    "demo:prepare": "./demo/load.sh && node --env-file=.env.local --import tsx demo/publish.mts",
    "demo:export-static": "node --env-file=.env.local --import tsx demo/export-static.mts",
    "github:check": "node --env-file=.env.local --import tsx scripts/check-github-app.mts",
    "collector": "node bin/temporal.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/agents": "^0.17.0",
    "next": "16.3.2",
    "openai": "7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
